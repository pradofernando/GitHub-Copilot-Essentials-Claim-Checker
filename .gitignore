.ruff_cache/

# Packaging output
build/
dist/
*.egg-info/
.eggs/

# Local environment settings and package-index credentials
.env
.env.*
!.env.example
.pypirc

# Local logs and operating-system metadata
*.log
.DS_Store
Thumbs.db
Desktop.ini
